    "Long task: background=true, then process(action=\"poll\"|\"log\"|\"submit\"|\"kill\", session_id=<hermes process id>).",
    "The Codex thread id is the thread_id in the first --json event line (thread.started); -o writes the last message to a file.",
    "Codex refuses to run outside a git repository; use --skip-git-repo-check for .git-data checkouts or mktemp -d && git init for scratch.",
)
HERMES_CLAUDE_NOTES = (
    "Never call bare `claude` from a gateway; it opens a TUI and hangs. Always -p.",
    "No PTY needed for -p; set a terminal timeout (300 s default, longer for builds).",
    "--output-format json returns session_id, num_turns, total_cost_usd; keep the session_id.",
    "401 Invalid authentication credentials on -p while `claude auth status` says Max means the Keychain and ~/.claude/.credentials.json disagree; repair that login before a retry, and never print tokens.",
    "Print mode skips trust and permission dialogs; --allowedTools is the write gate.",
)
CODEX_DESKTOP_NOTE = (
    "CLI or Herdr access to a Codex Desktop-owned thread must fork, never resume. "
    "Native desktop messaging may steer the existing thread."
)
NATIVE_ROUTES = ("A1", "A2", "B", "C", "D", "E")
