#!/usr/bin/env python3
"""orchestrate — the one menu for cross-runtime work.

Input: where I am (claude / codex / hermes), what I want (one of eight rows),
optional native session id. Output: the one command, what it returns, and the
escalation ladder (more work → steer → done).

Rows 1–4 are native one-shots and NEVER open a window.
Claude-to-Codex parallel workers use tracked one-shots unless --hosted is set.
Hosted rows go through the herdr skill (a Herdr pane, numbered close).

Deterministic: no network, no subprocess. Standard library only.
"""

from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import queue
import re
import shlex
import shutil
import subprocess
import sys
import threading
import time

RUNTIMES = ("claude", "codex", "hermes")

ROWS: tuple[tuple[str, str, str], ...] = (
    # key, number, plain-English row name
    ("quick", "1", "quick one-hitter"),
    ("advise", "2", "advise / second opinion"),
    ("review", "3", "review what we just did (token-cheap)"),
    ("fix", "4", "fix what we just ran"),
    ("grill", "5", "grill / back-and-forth"),
    ("converse", "6", "real-time conversation between two runtimes"),
    ("steer", "7", "steer the other runtime through this one"),
    ("parallel", "8", "parallel workers"),
)
ROW_BY_KEY = {key: (number, name) for key, number, name in ROWS}
ROW_ALIASES = {number: key for key, number, _ in ROWS}
ONE_SHOT_ROWS = ("quick", "advise", "review", "fix")
HERDR_ROWS = ("grill", "converse", "steer", "parallel")
CODE_ROWS = ("fix", "parallel")  # code work: never a Hermes child
# Codex sandboxes. Readers, reviewers, and graders (rows 1-3) always read; no caller flag widens them.
# Builders (rows 4 and 8) get full access in the repo they build, so they commit their own work.
READER_SANDBOX = "read-only"
BUILDER_SANDBOX = "danger-full-access"  # g-builders-full-access-readers-read-only

SHELF = Path(os.path.abspath(__file__)).parents[2]
HERDR_BIN = "~/.foxrun/skills/herdr/bin/herdr"
SEARCH_BIN = "~/.foxrun/skills/runtime-session-search/bin/runtime-session-search"


def herdr_installed() -> bool:
    """Use Herdr only when its command exists beside this skill."""
    return Path(HERDR_BIN).expanduser().is_file() and os.access(Path(HERDR_BIN).expanduser(), os.X_OK)
READ_ONLY_CLAUDE_TOOLS = "Read,Glob,Grep"
WRITE_CLAUDE_TOOLS = "Read,Edit,Write,Bash"

CONVERSATION_HINT = {
    "claude": "claude:$CLAUDE_CODE_SESSION_ID",
    "codex": "codex:<stable-thread-id> (in a Herdr pane: herdr:$HERDR_PANE_ID)",
    "hermes": "hermes:<session-id> (the gateway shell has no HERMES_SESSION_ID; pass it explicitly; Telegram: telegram:<chat>:<thread>)",
}

# ~10 lines that matter from the Nous-bundled Hermes `codex` and `claude-code`
# skills, so those bundled skills can stay disabled. Keep these true.
