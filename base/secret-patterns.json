[
  {
    "name": "op-reference",
    "regex": "(?:\"op://[^\"\\r\\n]*\"|'op://[^'\\r\\n]*'|`op://[^`\\r\\n]*`|op://[^\\s\\\"\\x27<>`]+)",
    "allow": true
  },
  {
    "name": "work-retry-key",
    "regex": "(?<![\\w-])retry-key=[0-9a-f]{64}(?![\\w-])",
    "allow": true
  },
  {
    "name": "sort-keys-argument",
    "regex": "(?<![\\w-])sort_keys=(?:True|False)(?=\\))",
    "allow": true
  },
  {
    "name": "github-token",
    "regex": "\\bgh[pousr]_[A-Za-z0-9]{36,}\\b"
  },
  {
    "name": "github-fine-grained",
    "regex": "\\bgithub_pat_[A-Za-z0-9_]{22,}\\b"
  },
  {
    "name": "anthropic-token",
    "regex": "\\bsk-ant-[A-Za-z0-9_-]{20,}\\b"
  },
  {
    "name": "openai-token",
    "regex": "\\bsk-(?:(?:proj|svcacct)-)?[A-Za-z0-9_-]{20,}\\b"
  },
  {
    "name": "aws-access-key",
    "regex": "\\b(?:AKIA|ASIA|AIDA|AROA|AIPA|ANPA|ANVA|ASCA)[A-Z0-9]{16}\\b"
  },
  {
    "name": "aws-secret-key",
    "regex": "(?i)\\baws_secret_access_key[\\s\\\"\\x27]*[:=]\\s*[\\\"\\x27]?(?P<value>[A-Za-z0-9/+=]{40})"
  },
  {
    "name": "slack-token",
    "regex": "\\bxox[baprs]-[A-Za-z0-9-]{10,}\\b"
  },
  {
    "name": "google-api-key",
    "regex": "\\bAIza[A-Za-z0-9_-]{35}\\b"
  },
  {
    "name": "google-oauth-token",
    "regex": "\\bya29\\.[A-Za-z0-9_-]{20,}\\b"
  },
  {
    "name": "private-key",
    "regex": "-----BEGIN (?:[A-Z0-9]+ )*PRIVATE KEY-----"
  },
  {
    "name": "bearer-value",
    "regex": "(?i)\\bauthorization[\\s\\\"\\x27]*[:=]\\s*[\\\"\\x27]?bearer\\s+(?P<value>[A-Za-z0-9_./+~=-]{8,})"
  },
  {
    "name": "cookie-value",
    "regex": "(?i)\\b(?:auth_token|ct0)[\\s\\\"\\x27]*[:=]\\s*[\\\"\\x27]?(?P<value>[^\\s;\\\"\\x27,}\\]]+)"
  },
  {
    "name": "entropy-assignment",
    "regex": "(?i)\\b[\\w-]{0,64}(?:key|token|secret|password)[\\w-]{0,64}[\\s\\\"\\x27]*[:=]\\s*(?P<quote>[\\\"\\x27])?(?P<value>[^\\s\\\"\\x27]{20,4096})",
    "entropy": 3.5,
    "distinct": 10,
    "expression": true
  },
  {
    "name": "bearer-token",
    "regex": "(?i)\\bbearer\\s+(?P<value>(?=[A-Za-z0-9_./+~=-]*[0-9])[A-Za-z0-9_./+~=-]{20,4096})",
    "entropy": 3.5,
    "distinct": 10
  }
]
