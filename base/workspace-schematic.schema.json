{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workspace schematic data",
  "description": "What workspace_schematic.py lint writes and the page draws. Names and counts only.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task", "title", "inputs", "groups", "summary", "database", "workspaces", "machine", "notes", "rules"],
  "properties": {
    "schema_version": {"type": "integer", "enum": [1]},
    "task": {"type": ["string", "null"], "pattern": "^T[0-9]+$"},
    "title": {"type": "string"},
    "inputs": {
      "type": "object", "additionalProperties": false, "required": ["files", "database", "blueprint", "decisions"],
      "properties": {
        "files": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["role", "path", "sha256"],
          "properties": {"role": {"type": "string"}, "path": {"$ref": "#/$defs/relative"}, "sha256": {"$ref": "#/$defs/sha"}}}},
        "database": {"type": "object", "additionalProperties": false, "required": ["path", "schema_sha256"],
          "properties": {"path": {"$ref": "#/$defs/relative"}, "schema_sha256": {"$ref": "#/$defs/sha"}}},
        "blueprint": {"type": "string", "pattern": "^v[0-9]+$"},
        "decisions": {"$ref": "#/$defs/relative"}
      }
    },
    "groups": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "label"],
      "properties": {"id": {"type": "string"}, "label": {"type": "string"}}}},
    "summary": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["workspace", "folders", "tables"],
      "properties": {"workspace": {"type": "string"}, "folders": {"$ref": "#/$defs/tally"}, "tables": {"$ref": "#/$defs/tally"}}}},
    "database": {
      "type": "object", "additionalProperties": false, "required": ["version", "lines", "counts", "summary"],
      "properties": {
        "version": {"type": "string"},
        "lines": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["what", "name", "status", "rules", "line"],
          "properties": {"what": {"type": "string", "enum": ["file", "table", "mirror", "trend", "view", "import", "module"]},
            "name": {"type": "string"}, "status": {"$ref": "#/$defs/status"}, "rules": {"$ref": "#/$defs/rules"}, "line": {"type": "string"}}}},
        "counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "summary": {"type": "object", "additionalProperties": false, "required": ["matches", "breaks", "decide"],
          "properties": {"matches": {"$ref": "#/$defs/count"}, "breaks": {"$ref": "#/$defs/count"}, "decide": {"$ref": "#/$defs/count"}}}
      }
    },
    "workspaces": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name", "folders", "tables"],
      "properties": {
        "name": {"type": "string"},
        "folders": {"type": "object", "additionalProperties": false, "required": ["on_disk", "function_source", "as_is", "model", "counts", "files"],
          "properties": {
            "on_disk": {"type": "boolean"},
            "function_source": {"type": "string"},
            "as_is": {"type": "array", "items": {"$ref": "#/$defs/as_is"}},
            "model": {"type": "array", "items": {"$ref": "#/$defs/model"}},
            "counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
            "files": {"type": "object", "additionalProperties": {"type": "integer"}}
          }},
        "tables": {"type": "object", "additionalProperties": false, "required": ["installed", "modules", "counts"],
          "properties": {
            "installed": {"type": "object", "additionalProperties": false, "required": ["expected", "found", "status", "rules", "line"],
              "properties": {"expected": {"type": "array", "items": {"type": "string"}}, "found": {"type": "array", "items": {"type": "string"}},
                "status": {"$ref": "#/$defs/status"}, "rules": {"$ref": "#/$defs/rules"}, "line": {"type": "string"}}},
            "modules": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name", "tier", "why", "collections", "counts"],
              "properties": {"name": {"type": "string"}, "tier": {"type": "string"}, "why": {"type": "string"},
                "collections": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name", "objects"],
                  "properties": {"name": {"type": "string"}, "objects": {"type": "array", "items": {"$ref": "#/$defs/object"}}}}},
                "counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}}}},
            "counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}
          }}
      }}},
    "machine": {"type": "object", "additionalProperties": false, "required": ["locations", "kinds", "fail"],
      "properties": {"locations": {"$ref": "#/$defs/count"}, "fail": {"$ref": "#/$defs/count"},
        "kinds": {"type": "array", "items": {"type": "object", "additionalProperties": false,
          "required": ["kind", "locations", "pass", "fail", "not_verified", "rules", "status", "line"],
          "properties": {"kind": {"type": "string"}, "locations": {"$ref": "#/$defs/count"}, "pass": {"$ref": "#/$defs/count"},
            "fail": {"$ref": "#/$defs/count"}, "not_verified": {"$ref": "#/$defs/count"}, "rules": {"$ref": "#/$defs/rules"}, "status": {"$ref": "#/$defs/status"}, "line": {"type": "string"}}}}}},
    "notes": {"type": "object", "additionalProperties": {"type": "string"}},
    "rules": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["name", "status"],
      "properties": {"name": {"type": "string"}, "status": {"type": "string"}}}}
  },
  "$defs": {
    "count": {"type": "integer", "minimum": 0},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relative": {"type": "string", "pattern": "^[^/]"},
    "status": {"type": "string", "enum": ["matches", "change", "not on disk", "decide", "not checked", "optional"]},
    "rules": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}},
    "tally": {"type": "object", "additionalProperties": false, "required": ["matches", "breaks", "decide", "not_checked"],
      "properties": {"matches": {"$ref": "#/$defs/count"}, "breaks": {"$ref": "#/$defs/count"}, "decide": {"$ref": "#/$defs/count"}, "not_checked": {"$ref": "#/$defs/count"}}},
    "dm1": {"type": ["object", "null"], "additionalProperties": false, "required": ["move", "keep", "ask", "not_listed", "protected", "homes"],
      "properties": {"move": {"$ref": "#/$defs/count"}, "keep": {"$ref": "#/$defs/count"}, "ask": {"$ref": "#/$defs/count"},
        "not_listed": {"$ref": "#/$defs/count"}, "protected": {"$ref": "#/$defs/count"},
        "homes": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["home", "files"],
          "properties": {"home": {"type": "string"}, "files": {"$ref": "#/$defs/count"}}}}}},
    "as_is": {"type": "object", "additionalProperties": false,
      "required": ["path", "name", "depth", "kind", "group", "status", "collection", "to", "rules", "line", "files", "opened", "dm1", "counted", "nested"],
      "properties": {"path": {"$ref": "#/$defs/relative"}, "name": {"type": "string"}, "depth": {"type": "integer", "minimum": 0},
        "kind": {"type": "string", "enum": ["file", "folder", "link", "files", "folders"]}, "group": {"type": "string"},
        "counted": {"type": "boolean"}, "nested": {"type": "boolean"},
        "status": {"type": "string", "enum": ["matches", "change", "decide", "not checked"]},
        "collection": {"type": ["string", "null"]}, "to": {"type": ["string", "null"]}, "rules": {"$ref": "#/$defs/rules"},
        "line": {"type": "string"}, "files": {"type": ["integer", "null"]}, "opened": {"type": "boolean"}, "dm1": {"$ref": "#/$defs/dm1"}}},
    "model": {"type": "object", "additionalProperties": false,
      "required": ["path", "name", "depth", "kind", "group", "collection", "rules", "required", "status", "line", "from", "counted"],
      "properties": {"path": {"$ref": "#/$defs/relative"}, "name": {"type": "string"}, "depth": {"type": "integer", "minimum": 0},
        "kind": {"type": "string", "enum": ["file", "folder"]}, "group": {"type": "string"}, "collection": {"type": "string"},
        "rules": {"$ref": "#/$defs/rules"}, "required": {"type": "boolean"},
        "status": {"type": "string", "enum": ["matches", "not on disk", "optional", "not checked"]}, "line": {"type": "string"},
        "from": {"type": "array", "items": {"type": "string"}}, "counted": {"type": "boolean"}}},
    "object": {"type": "object", "additionalProperties": false,
      "required": ["name", "kind", "kind_db", "status", "fields_model", "fields_db", "extra_fields", "missing_fields", "type_fields", "rules", "line", "scope", "rows", "load", "sources"],
      "properties": {"name": {"type": "string"}, "kind": {"type": "string", "enum": ["table", "mirror", "trend", "view", "import"]},
        "kind_db": {"type": ["string", "null"], "enum": ["table", "view", null]},
        "status": {"$ref": "#/$defs/status"}, "fields_model": {"$ref": "#/$defs/count"}, "fields_db": {"type": ["integer", "null"]},
        "extra_fields": {"type": "array", "items": {"type": "string"}}, "missing_fields": {"type": "array", "items": {"type": "string"}},
        "type_fields": {"type": "array", "items": {"type": "string"}}, "rules": {"$ref": "#/$defs/rules"}, "line": {"type": "string"},
        "scope": {"type": "string", "enum": ["workspace", "shared", "view", "import"]}, "rows": {"type": ["integer", "null"]},
        "load": {"type": "string", "enum": ["none", "not counted", "nothing to load", "waiting", "part", "loaded"]},
        "sources": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["store", "table", "rows"],
          "properties": {"store": {"$ref": "#/$defs/relative"}, "table": {"type": "string"}, "rows": {"type": ["integer", "null"]}}}}}}
  }
}
